{
  "name": "@ts-linq/orm",
  "version": "4.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@ts-linq/concurrency": "workspace:*",
    "@ts-linq/core": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/metrics-safe": "workspace:*",
    "@ts-linq/migrations": "workspace:*",
    "@ts-linq/query": "workspace:*",
    "@ts-linq/sql-visitor": "workspace:*",
    "@ts-linq/telemetry": "workspace:*",
    "@ts-linq/types": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run gen:esm-entry",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  }
}

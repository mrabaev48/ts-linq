{
  "name": "@ts-linq/cli",
  "version": "1.3.29",
  "description": "Command-line tools for ts-linq ORM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ts-linq": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "keywords": [
    "orm",
    "cli",
    "migrations",
    "code-generation",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "@ts-linq/migrations": "workspace:*"
  },
  "optionalDependencies": {
    "@ts-linq/dialect-mssql": "workspace:*",
    "@ts-linq/dialect-mysql": "workspace:*",
    "@ts-linq/dialect-postgres": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/provider-mysql": "workspace:*",
    "@ts-linq/provider-mssql": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0"
  }
}

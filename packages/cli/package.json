{
  "name": "@ts-linq/cli",
  "version": "1.0.0",
  "description": "Command-line tools for ts-linq ORM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ts-linq": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "orm",
    "cli",
    "migrations",
    "code-generation",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "@ts-linq/migrations": "workspace:*",
    "@ts-linq/provider-sqlite": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/provider-mysql": "workspace:*",
    "@ts-linq/provider-mssql": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^24.3.0"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0"
  }
}

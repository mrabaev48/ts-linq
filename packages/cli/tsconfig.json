{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {

      "@ts-linq/provider-postgres": ["../provider-postgres/dist"],
      "@ts-linq/provider-mysql": ["../provider-mysql/dist"],
      "@ts-linq/provider-mssql": ["../provider-mssql/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "tests"],
  "references": [
    { "path": "../types" },
    { "path": "../core" },
    { "path": "../migrations" },

    { "path": "../provider-postgres" },
    { "path": "../provider-mysql" },
    { "path": "../provider-mssql" }
  ]
}

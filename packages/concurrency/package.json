{
  "name": "@ts-linq/concurrency",
  "version": "2.0.2",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ts-linq/types": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -b tsconfig.esm.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  }
}

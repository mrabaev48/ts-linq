{
  "name": "@ts-linq/metrics-safe",
  "version": "1.2.12",
  "private": true,
  "description": "Safe helpers for optional metrics/logging in ts-linq",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/esm/memory.js",
      "require": "./dist/memory.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run gen:esm-entry",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test-d": "tsd",
    "lint": "eslint . --fix"
  },
  "peerDependencies": {},
  "dependencies": {
    "@ts-linq/types": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "tsd": "^0.30.7",
    "typescript": "^5.4.5"
  },
  "tsd": {
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "@ts-linq/metrics-safe/memory": [
          "./dist/memory.d.ts"
        ]
      }
    }
  }
}

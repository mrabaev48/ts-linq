{
  "name": "@ts-linq/metrics-safe",
  "version": "1.0.0",
  "private": true,
  "description": "Safe helpers for optional metrics/logging in ts-linq",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run gen:esm-entry",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^24.3.0"
  }
}

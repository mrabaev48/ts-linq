{
  "name": "@ts-linq/metrics-safe",
  "version": "1.0.0",
  "private": true,
  "description": "Safe helpers for optional metrics/logging in ts-linq",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@ts-linq/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^24.3.0"
  }
}

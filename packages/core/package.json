{
  "name": "@ts-linq/core",
  "version": "3.4.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@ts-linq/types": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/metrics-safe": "workspace:*",
    "@ts-linq/ast": "workspace:*",
    "@ts-linq/concurrency": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run gen:esm-entry && npm run copy:types",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "copy:types": "node ../../scripts/copy-types.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  }
}

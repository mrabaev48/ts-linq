{
  "name": "@ts-linq/provider-postgres",
  "version": "3.0.3",
  "private": true,
  "description": "Postgres database provider for ts-linq ORM",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/dialect-postgres": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "@ts-linq/metadata": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/dialect-mssql": "workspace:*",
    "@ts-linq/dialect-mysql": "workspace:*",
    "@ts-linq/migrations": "workspace:*",
    "@ts-linq/query": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && npm run gen:esm-entry && npm run copy:types",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "copy:types": "node ../../scripts/copy-types.js",
    "test": "cd ../.. && npx jest packages/provider-postgres",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  }
}

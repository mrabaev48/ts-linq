{
  "name": "@ts-linq/cache-memcached",
  "version": "1.0.18",
  "description": "Memcached adapters for ts-linq caches (SqlCache, CountCache)",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run gen:esm-entry",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "gen:esm-entry": "node scripts/gen-esm-entry.cjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "keywords": [
    "orm",
    "cache",
    "memcached",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/types": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "memjs": ">=1.3.0",
    "typescript": ">=4.9.0"
  },
  "peerDependenciesMeta": {
    "memjs": {
      "optional": true
    }
  }
}

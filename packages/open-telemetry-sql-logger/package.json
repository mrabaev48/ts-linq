{
  "name": "@ts-linq/open-telemetry-sql-logger",
  "version": "13.0.2",
  "private": true,
  "description": "OpenTelemetry SqlLogger implementation for ts-linq (optional package)",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -b tsconfig.esm.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@ts-linq/types": "workspace:*"
  },
  "peerDependencies": {
    "@ts-linq/core": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  }
}

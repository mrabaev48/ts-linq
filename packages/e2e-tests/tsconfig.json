{
  "extends": "@ts-linq/typescript-config/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2021", "ES2022.Error"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@ts-linq/query/internal": ["../query/src/internal"],
      "@ts-linq/sql-visitor/internal": ["../sql-visitor/src/internal"],
      "@ts-linq/core": ["../core/src"],
      "@ts-linq/orm": ["../orm/src"],
      "@ts-linq/query": ["../query/src"],
      "@ts-linq/metadata": ["../metadata/src"],
      "@ts-linq/types": ["../types/src"],
      "@ts-linq/metrics-safe": ["../metrics-safe/src"],
      "@ts-linq/testkits": ["../testkits/src"],
      "@ts-linq/provider-postgres": ["../provider-postgres/src"],
      "@ts-linq/provider-mysql": ["../provider-mysql/src"],
      "@ts-linq/provider-mssql": ["../provider-mssql/src"],
      "@ts-linq/dialect-postgres": ["../dialect-postgres/src"],
      "@ts-linq/dialect-mysql": ["../dialect-mysql/src"],
      "@ts-linq/dialect-mssql": ["../dialect-mssql/src"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}

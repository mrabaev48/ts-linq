{
  "name": "@ts-linq/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for ts-linq ORM across all database providers",
  "scripts": {
    "test": "jest",
    "test:postgres": "jest --testNamePattern=postgres",
    "test:mysql": "jest --testNamePattern=mysql",
    "test:mssql": "jest --testNamePattern=mssql",
    "test:docker": "docker-compose -f ../../docker-compose.test.yml up -d && jest && docker-compose -f ../../docker-compose.test.yml down",
    "test:docker-compose": "docker compose -f ../../docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e-runner",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/orm": "workspace:*",
    "@ts-linq/testkits": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/provider-mysql": "workspace:*",
    "@ts-linq/provider-mssql": "workspace:*",
    "@ts-linq/query": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "@ts-linq/metrics-safe": "workspace:*",
    "@ts-linq/dialect-postgres": "workspace:*",
    "@ts-linq/dialect-mysql": "workspace:*",
    "@ts-linq/dialect-mssql": "workspace:*"
  },
  "devDependencies": {
    "@ts-linq/jest-config": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "mssql": "^12.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}

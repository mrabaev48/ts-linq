{
  "name": "@ts-linq/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for ts-linq ORM across all database providers",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:sqlite": "jest --testNamePattern=sqlite --passWithNoTests",
    "test:postgres": "jest --testNamePattern=postgres --passWithNoTests",
    "test:mysql": "jest --testNamePattern=mysql --passWithNoTests",
    "test:mssql": "jest --testNamePattern=mssql --passWithNoTests"
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/orm": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/testkits": "workspace:*",
    "@ts-linq/provider-sqlite": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/provider-mysql": "workspace:*",
    "@ts-linq/provider-mssql": "workspace:*",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}

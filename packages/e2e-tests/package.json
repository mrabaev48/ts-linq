{
  "name": "@ts-linq/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for ts-linq ORM across all database providers",
  "scripts": {
    "test": "jest",
    "test:sqlite": "jest --testNamePattern=sqlite",
    "test:postgres": "jest --testNamePattern=postgres",
    "test:mysql": "jest --testNamePattern=mysql",
    "test:mssql": "jest --testNamePattern=mssql",
    "test:docker": "docker-compose -f ../../docker-compose.test.yml up -d && jest && docker-compose -f ../../docker-compose.test.yml down"
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/testkits": "workspace:*",
    "@ts-linq/provider-sqlite": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/provider-mysql": "workspace:*",
    "@ts-linq/provider-mssql": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}

{
  "name": "@ts-linq/provider-sqlite",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Sqlite database provider for ts-linq ORM",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/dialect-sqlite": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "@ts-linq/metadata": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^24.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && npm run gen:esm-entry && npm run copy:types",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "copy:types": "node ../../scripts/copy-types.js"
  }
}

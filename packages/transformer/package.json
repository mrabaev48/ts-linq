{
  "name": "@ts-linq/transformer",
  "version": "2.1.7",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@ts-linq/ast": "workspace:*",
    "@ts-linq/types": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && npm run gen:esm-entry && npm run copy:types",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "copy:types": "node ../../scripts/copy-types.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  }
}

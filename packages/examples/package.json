{
  "name": "@ts-linq/examples",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Runnable example programs demonstrating the ts-linq public API",
  "scripts": {
    "build": "ts-linq-transform build -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "example:crud": "node dist/crud.js",
    "example:linq-queries": "node dist/linq-queries.js"
  },
  "dependencies": {
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/orm": "workspace:*",
    "@ts-linq/provider-postgres": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@ts-linq/transformer-morph": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.4.5"
  }
}

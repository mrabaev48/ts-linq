{
  "extends": "@ts-linq/typescript-config/node.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@ts-linq/query/internal": ["./node_modules/@ts-linq/query/dist/internal/index.d.ts"]
    }
  },
  "include": ["tests-new/**/*.ts", "src/**/*.ts"]
}



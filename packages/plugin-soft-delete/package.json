{
  "name": "@ts-linq/plugin-soft-delete",
  "version": "2.0.0",
  "private": true,
  "description": "Soft delete plugin",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@ts-linq/types": "workspace:*",
    "@ts-linq/metadata": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@ts-linq/jest-config": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.3.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.5"
  }
}

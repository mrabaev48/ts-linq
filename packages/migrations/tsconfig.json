{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@ts-linq/core": ["../core/dist"],
      "@ts-linq/metadata": ["../metadata/dist"],
      "@ts-linq/types": ["../types/dist"],
      "@ts-linq/metrics-safe": ["../metrics-safe/dist"]
    },
    "composite": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "tests", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../metrics-safe" },
    { "path": "../types" },
    { "path": "../metadata" },
    { "path": "../core" }
  ]
}

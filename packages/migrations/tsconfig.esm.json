{
  "extends": "@ts-linq/typescript-config/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@ts-linq/core": ["../core/dist"],
      "@ts-linq/metadata": ["../metadata/dist"],
      "@ts-linq/types": ["../types/dist"],
      "@ts-linq/metrics-safe": ["../metrics-safe/dist"]
    },
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "./dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "tests", "**/*.test.ts", "**/*.spec.ts"]
}

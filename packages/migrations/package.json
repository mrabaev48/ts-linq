{
  "name": "@ts-linq/migrations",
  "version": "2.8.8",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold/scaffold-db-context.d.ts",
      "import": "./dist/esm/scaffold/scaffold-db-context.js",
      "require": "./dist/scaffold/scaffold-db-context.js"
    }
  },
  "dependencies": {
    "@ts-linq/core": "workspace:*",
    "@ts-linq/metadata": "workspace:*",
    "@ts-linq/types": "workspace:*",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@ts-linq/dialect-mssql": "workspace:*",
    "@ts-linq/dialect-mysql": "workspace:*",
    "@ts-linq/dialect-postgres": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@ts-linq/eslint-config": "workspace:*",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && npm run gen:esm-entry && npm run copy:types",
    "gen:esm-entry": "echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "copy:types": "node ../../scripts/copy-types.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  }
}

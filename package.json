{
  "name": "ts-linq",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "workspaces": [
    "packages/*",
    "packages/open-telemetry-sql-logger",
    "packages/prometheus-sql-logger",
    "packages/composite-sql-logger"
  ],
  "main": "./packages/core/dist/esm/index.js",
  "module": "./packages/core/dist/esm/index.js",
  "types": "./packages/core/dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/esm/index.d.ts",
      "import": "./packages/core/dist/esm/index.js",
      "require": "./packages/core/dist/esm/index.js"
    },
    "./provider-postgres": {
      "types": "./packages/provider-postgres/dist/esm/index.d.ts",
      "import": "./packages/provider-postgres/dist/esm/index.js",
      "require": "./packages/provider-postgres/dist/esm/index.js"
    },
    "./provider-mysql": {
      "types": "./packages/provider-mysql/dist/esm/index.d.ts",
      "import": "./packages/provider-mysql/dist/esm/index.js",
      "require": "./packages/provider-mysql/dist/esm/index.js"
    },
    "./provider-mssql": {
      "types": "./packages/provider-mssql/dist/esm/index.d.ts",
      "import": "./packages/provider-mssql/dist/esm/index.js",
      "require": "./packages/provider-mssql/dist/esm/index.js"
    }
  },
  "files": [
    "packages/*/dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "jest",
    "test:unit": "jest -c ./jest.unit.config.js",
    "test:integration": "pnpm -F @ts-linq/integration-tests test",
    "test:e2e": "pnpm -F @ts-linq/e2e-tests test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "lint": "turbo run lint",
    "ts-patch:install": "ts-patch install",
    "ts-patch:compile:examples": "tspc -p packages/examples/tsconfig.json",
    "docs": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "arch:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "arch:deps:json": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type json > reports/dependency-cruiser.json",
    "arch:deps:dot": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type dot > reports/dependency-graph.dot",
    "arch:deps:graph": "mkdir -p reports && depcruise packages --config .dependency-cruiser.cjs --output-type dot | dot -T svg > reports/dependency-cruiser-graph.svg",
    "arch:cycles": "madge --circular --extensions ts,tsx --ts-config ./tsconfig.json --exclude 'node_modules|dist|build|coverage|reports|issues-v3|\\.test\\.ts$|\\.spec\\.ts$|\\.d\\.ts$' packages",
    "arch:graph": "mkdir -p reports && madge --extensions ts,tsx --ts-config ./tsconfig.json --exclude 'node_modules|dist|build|coverage|reports|issues-v3|\\.test\\.ts$|\\.spec\\.ts$|\\.d\\.ts$' --image reports/madge-graph.svg packages",
    "arch:dead": "ts-prune | grep -v -f ts-prune-ignore.txt || true",
    "arch:phantom": "node scripts/check-phantom-deps.js",
    "arch:audit": "pnpm typecheck && pnpm arch:deps && pnpm arch:cycles && pnpm arch:dead && pnpm arch:phantom"
  },
  "keywords": [
    "orm",
    "typescript",
    "database",
    "entity-framework",
    "linq",
    "postgresql",
    "mysql",
    "mssql"
  ],
  "author": "",
  "license": "ISC",
  "description": "A TypeScript ORM framework inspired by Entity Framework Core with decorator-based entities, LINQ-style querying, and multi-database support",
  "dependencies": {
    "@types/node": "^24.3.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@jest/globals": "^30.2.0",
    "@jest/test-sequencer": "^29.7.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@ts-linq/eslint-config": "workspace:*",
    "@ts-linq/jest-config": "workspace:*",
    "@ts-linq/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.3",
    "prettier": "^3.3.3",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.4.5",
    "ts-patch": "^3.3.0",
    "ts-prune": "^0.10.3",
    "tsd": "^0.30.7",
    "turbo": "^2.5.8",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript-eslint": "^8.59.3"
  }
}

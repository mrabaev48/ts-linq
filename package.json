{
  "name": "ts-linq",
  "version": "1.0.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "ts-node src/index.ts",
    "example:simple": "ts-node examples/simple-app.ts",
    "example:advanced": "ts-node examples/advanced-queries.ts",
    "example:sqlite": "ts-node examples/sqlite-app.ts",
    "example:postgres": "ts-node examples/postgres-app.ts",
    "example:mysql": "ts-node examples/mysql-app.ts",
    "docs": "typedoc",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/sqlite3": "^3.1.11",
    "jest": "^30.1.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-check": "^4.3.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "^4.8.1"
  }
}

{
  "name": "ts-linq",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "workspaces": [
    "packages/*",
    "packages/open-telemetry-sql-logger",
    "packages/prometheus-sql-logger",
    "packages/composite-sql-logger"
  ],
  "main": "./packages/core/dist/esm/index.js",
  "module": "./packages/core/dist/esm/index.js",
  "types": "./packages/core/dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/esm/index.d.ts",
      "import": "./packages/core/dist/esm/index.js",
      "require": "./packages/core/dist/esm/index.js"
    },
    "./provider-postgres": {
      "types": "./packages/provider-postgres/dist/esm/index.d.ts",
      "import": "./packages/provider-postgres/dist/esm/index.js",
      "require": "./packages/provider-postgres/dist/esm/index.js"
    },
    "./provider-mysql": {
      "types": "./packages/provider-mysql/dist/esm/index.d.ts",
      "import": "./packages/provider-mysql/dist/esm/index.js",
      "require": "./packages/provider-mysql/dist/esm/index.js"
    },
    "./provider-mssql": {
      "types": "./packages/provider-mssql/dist/esm/index.d.ts",
      "import": "./packages/provider-mssql/dist/esm/index.js",
      "require": "./packages/provider-mssql/dist/esm/index.js"
    }
  },
  "files": [
    "packages/*/dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "build:types": "turbo run build --filter=@ts-linq/types",
    "build:metrics-safe": "turbo run build --filter=@ts-linq/metrics-safe",
    "build:ast": "turbo run build --filter=@ts-linq/ast",
    "build:metadata": "turbo run build --filter=@ts-linq/metadata",
    "build:concurrency": "turbo run build --filter=@ts-linq/concurrency",
    "build:cache": "turbo run build --filter=@ts-linq/cache",
    "build:cache-redis": "turbo run build --filter=@ts-linq/cache-redis",
    "build:cache-memcached": "turbo run build --filter=@ts-linq/cache-memcached",
    "build:core": "turbo run build --filter=@ts-linq/core",
    "build:query": "turbo run build --filter=@ts-linq/query",
    "build:orm": "turbo run build --filter=@ts-linq/orm",

    "build:dialect-postgres": "turbo run build --filter=@ts-linq/dialect-postgres",
    "build:dialect-mysql": "turbo run build --filter=@ts-linq/dialect-mysql",
    "build:dialect-mssql": "turbo run build --filter=@ts-linq/dialect-mssql",
    "build:dialects": "turbo run build --filter=@ts-linq/dialect-postgres --filter=@ts-linq/dialect-mysql --filter=@ts-linq/dialect-mssql",
    "build:provider-postgres": "turbo run build --filter=@ts-linq/provider-postgres",
    "build:provider-mysql": "turbo run build --filter=@ts-linq/provider-mysql",
    "build:provider-mssql": "turbo run build --filter=@ts-linq/provider-mssql",
    "build:providers": "turbo run build --filter=@ts-linq/provider-postgres --filter=@ts-linq/provider-mysql --filter=@ts-linq/provider-mssql",
    "build:cli": "turbo run build --filter=@ts-linq/cli",
    "build:config": "turbo run build --filter=@ts-linq/config",
    "build:migrations": "turbo run build --filter=@ts-linq/migrations",
    "build:pagination": "turbo run build --filter=@ts-linq/pagination",
    "build:sql-visitor": "turbo run build --filter=@ts-linq/sql-visitor",
    "build:telemetry": "turbo run build --filter=@ts-linq/telemetry",
    "build:testkits": "turbo run build --filter=@ts-linq/testkits",
    "build:composite-sql-logger": "turbo run build --filter=@ts-linq/composite-sql-logger",
    "build:prometheus-sql-logger": "turbo run build --filter=@ts-linq/prometheus-sql-logger",
    "build:open-telemetry-sql-logger": "turbo run build --filter=@ts-linq/open-telemetry-sql-logger",
    "build:plugin-audit": "turbo run build --filter=@ts-linq/plugin-audit",
    "build:plugin-multi-tenant": "turbo run build --filter=@ts-linq/plugin-multi-tenant",
    "build:plugin-soft-delete": "turbo run build --filter=@ts-linq/plugin-soft-delete",
    "build:integration-nestjs": "turbo run build --filter=@ts-linq/integration-nestjs",
    "build:examples": "turbo run build --filter=@ts-linq/examples",
    "build:e2e-tests": "turbo run build --filter=@ts-linq/e2e-tests",
    "test": "jest",
    "test:unit": "jest -c ./jest.unit.config.js",
    "test:integration": "pnpm -F @ts-linq/integration-tests test",
    "test:e2e": "pnpm -F @ts-linq/e2e-tests test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npx eslint --fix",
    "example:simple": "ts-node examples/simple-app.ts",
    "example:advanced": "ts-node examples/advanced-queries.ts",
    "example:basic": "ts-node examples/basic-usage.ts",
    "example:migrations": "ts-node examples/migrations.ts",

    "example:postgres": "ts-node examples/postgres-app.ts",
    "example:mysql": "ts-node examples/mysql-app.ts",
    "example:mssql": "ts-node examples/mssql-app.ts",
    "docs": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "orm",
    "typescript",
    "database",
    "entity-framework",
    "linq",

    "postgresql",
    "mysql",
    "mssql"
  ],
  "author": "",
  "license": "ISC",
  "description": "A TypeScript ORM framework inspired by Entity Framework Core with decorator-based entities, LINQ-style querying, and multi-database support",
  "dependencies": {
    "@types/node": "^24.3.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@jest/test-sequencer": "^29.7.0",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-check": "^4.3.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.3",
    "prettier": "^3.3.3",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",


    "testcontainers": "^10.9.0",
    "ts-jest": "^29.4.5",
    "tsd": "^0.30.7",
    "turbo": "^2.5.8",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "^4.8.1"
  }
}

{
  "name": "ts-linq",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "./packages/core/dist/index.js",
  "module": "./packages/core/dist/index.esm.js", 
  "types": "./packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.esm.js",
      "require": "./packages/core/dist/index.js"
    },
    "./sqlite": {
      "types": "./packages/sqlite/dist/index.d.ts",
      "import": "./packages/sqlite/dist/index.esm.js",
      "require": "./packages/sqlite/dist/index.js"
    },
    "./postgres": {
      "types": "./packages/postgres/dist/index.d.ts",
      "import": "./packages/postgres/dist/index.esm.js",
      "require": "./packages/postgres/dist/index.js"
    },
    "./mysql": {
      "types": "./packages/mysql/dist/index.d.ts",
      "import": "./packages/mysql/dist/index.esm.js", 
      "require": "./packages/mysql/dist/index.js"
    },
    "./mssql": {
      "types": "./packages/mssql/dist/index.d.ts",
      "import": "./packages/mssql/dist/index.esm.js",
      "require": "./packages/mssql/dist/index.js"
    }
  },
  "files": [
    "packages/*/dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/core",
    "build:providers": "npm run build -w packages/sqlite -w packages/postgres -w packages/mysql -w packages/mssql",
    "build:cli": "npm run build -w packages/cli",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "ts-node src/index.ts",
    "example:simple": "ts-node examples/simple-app.ts",
    "example:advanced": "ts-node examples/advanced-queries.ts",
    "example:sqlite": "ts-node examples/sqlite-app.ts",
    "example:postgres": "ts-node examples/postgres-app.ts",
    "example:mysql": "ts-node examples/mysql-app.ts",
    "docs": "typedoc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "bench": "ts-node bench/quick.ts",
    "bench:multi": "ts-node bench/multi.ts",
    "bench:profile:cpu": "node --cpu-prof -r ts-node/register/transpile-only bench/multi.ts",
    "bench:profile:heap": "node --heap-prof -r ts-node/register/transpile-only bench/multi.ts"
  },
  "keywords": [
    "orm",
    "typescript",
    "database",
    "entity-framework",
    "linq",
    "sqlite",
    "postgresql",
    "mysql",
    "mssql"
  ],
  "author": "",
  "license": "ISC",
  "description": "A TypeScript ORM framework inspired by Entity Framework Core with decorator-based entities, LINQ-style querying, and multi-database support",
  "dependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.1",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^30.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-check": "^4.3.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.12",
    "typedoc-plugin-markdown": "^4.8.1"
  }
}
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {}
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/provider-postgres" },
    { "path": "packages/provider-mysql" },
    { "path": "packages/provider-mssql" },
    { "path": "packages/cli" },
    { "path": "packages/cache-redis" },
    { "path": "packages/cache-memcached" }
  ]
}

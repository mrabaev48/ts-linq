{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node"
  },
  "files": [],
  "references": [
    { "path": "packages/ast" },
    { "path": "packages/core" },
    { "path": "packages/sqlite" },
    { "path": "packages/postgres" },
    { "path": "packages/mysql" },
    { "path": "packages/mssql" },
    { "path": "packages/cli" }
  ]
}

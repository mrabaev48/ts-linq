modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Install Dependencies"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "install-deps"

[[workflows.workflow]]
name = "Install Dependencies"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install reflect-metadata sqlite3 typescript ts-node @types/node @types/sqlite3 jest ts-jest @types/jest"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "install-deps"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

{
  "root": true,
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": ["@ts-linq/eslint-config"],
  "parserOptions": {
    "project": [
      "./tsconfig.eslint.json",
      "./packages/*/tsconfig.eslint.json"
    ],
    "sourceType": "module"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "packages/*/dist/**",
    "packages/*/test-d/**",
    "packages/**/tests/**/*.d.ts",
    "docs/**",
    "shop.db",
    "examples/**",
    "jest*.config.js",
    "jest*.config.cjs",
    "jest*.config.mjs",
    "packages/integration-tests/jest.sequencer.js"
  ]
}

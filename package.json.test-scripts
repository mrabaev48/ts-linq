{
  "scripts": {
    "test:e2e": "jest --testPathPatterns=e2e --runInBand",
    "test:e2e:docker": "docker-compose -f docker-compose.test.yml up -d && npm run test:e2e && docker-compose -f docker-compose.test.yml down",
    "test:e2e:sqlite": "jest --testPathPatterns=e2e --testNamePattern=sqlite",
    "test:e2e:postgres": "jest --testPathPatterns=e2e --testNamePattern=postgres",
    "test:e2e:mysql": "jest --testPathPatterns=e2e --testNamePattern=mysql",
    "test:e2e:mssql": "jest --testPathPatterns=e2e --testNamePattern=mssql",
    "test:all": "npm run test && npm run test:e2e"
  }
}
